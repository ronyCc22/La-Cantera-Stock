@model IEnumerable<LaCanteraStock.Models.Producto>
@{
    ViewData["Title"] = "Stock en Tienda - Mostrador";
    var tallasDisponibles = (List<LaCanteraStock.Models.Talla>)ViewBag.Tallas;
    var todosProductoTallas = (List<LaCanteraStock.Models.ProductoTalla>)ViewBag.ProductosTallas;
    string catSeleccionada = ViewBag.CategoriaSeleccionada as string ?? "";
}

<div class="container-fluid py-4 px-lg-5" style="background-color: #f8fafc; min-height: 85vh;">
    <!-- Encabezado de Mostrador -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge" style="background-color: #08182b; color: #00d166; font-size: 0.8rem;">
                    <i class="fas fa-boxes me-1"></i> MOSTRADOR CAJAMARCA
                </span>
                <span class="text-muted small">| Jr. Batán N° 404</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Stock de Prendas en Tienda</h2>
            <p class="text-muted small mb-0">Consulta inmediata de modelos, tallas y existencias para despacho rápido al cliente</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
                <i class="fas fa-table"></i> Vista Tabla
            </a>
            <a asp-action="Create" class="btn btn-sm fw-bold px-3 d-flex align-items-center gap-1" style="background-color: #00d166; color: #08182b;">
                <i class="fas fa-plus-circle"></i> Nueva Prenda
            </a>
        </div>
    </div>

    <!-- Barra de Filtros Rápida -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body p-3">
            <form asp-action="Catalogo" method="get" class="row g-2 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label small fw-bold text-secondary mb-1">
                        <i class="fas fa-search me-1"></i>Buscar prenda o equipo
                    </label>
                    <input type="text" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Ej: Miami, Milan, Madrid, Brasil..." />
                </div>

                <div class="col-lg-3 col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">
                        <i class="fas fa-filter me-1"></i>Tipo de Prenda
                    </label>
                    <select name="categoria" class="form-select">
                        <option value="">-- Todas las Prendas --</option>
                        <option value="Camisetas" selected="@(catSeleccionada.ToLower() == "camisetas")">Solo Camisetas</option>
                        <option value="Shorts" selected="@(catSeleccionada.ToLower() == "shorts")">Solo Shorts</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">
                        <i class="fas fa-ruler me-1"></i>Filtrar por Talla
                    </label>
                    <select name="tallaId" class="form-select">
                        <option value="">-- Cualquier Talla --</option>
                        @if (tallasDisponibles != null)
                        {
                            foreach (var t in tallasDisponibles)
                            {
                                <option value="@t.TallaID" selected="@(ViewBag.TallaSeleccionada == t.TallaID)">Talla @t.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 fw-semibold">
                        <i class="fas fa-filter me-1"></i> Filtrar
                    </button>
                    <a asp-action="Catalogo" class="btn btn-outline-secondary" title="Reestablecer">
                        <i class="fas fa-undo"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Resultados y Cuadrícula de Tarjetas -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center py-5 rounded-4">
            <div class="card-body">
                <i class="fas fa-search fa-3x text-muted mb-3 opacity-50"></i>
                <h5 class="fw-bold text-dark">No se encontraron prendas</h5>
                <p class="text-muted small mb-3">No hay artículos que coincidan con los filtros aplicados en este momento.</p>
                <a asp-action="Catalogo" class="btn btn-outline-dark btn-sm">Ver todo el catálogo</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                var ptDeEsteProducto = todosProductoTallas != null ? todosProductoTallas.Where(x => x.ProductoID == item.ProductoID).ToList() : new List<LaCanteraStock.Models.ProductoTalla>();
                var stockTotal = ptDeEsteProducto.Sum(x => x.StockActual);
                bool esCamiseta = item.CategoriaID == 1 || item.Nombre.ToLower().Contains("camiseta");

                // Extracción automática de la ruta de la foto y texto limpio desde Descripcion
                string rutaFoto = "";
                string descripcionLimpia = item.Descripcion ?? "";

                if (!string.IsNullOrEmpty(item.Descripcion) && item.Descripcion.Contains("Foto:"))
                {
                    var partes = item.Descripcion.Split("Foto:");
                    descripcionLimpia = partes[0].Trim();
                    rutaFoto = partes[1].Trim();
                }

                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="background-color: #ffffff;">

                        <!-- Badge de Categoría en esquina -->
                        <span class="position-absolute top-0 start-0 m-3 badge rounded-pill px-3 py-1 shadow-sm" style="background-color: #08182b; color: #00d166; font-size: 0.75rem; z-index: 2;">
                            @(esCamiseta ? "Camiseta" : "Short")
                        </span>

                        <!-- Zona de Fotografía del Producto -->
                        <div class="d-flex align-items-center justify-content-center p-3" style="height: 230px; background-color: #f1f5f9;">
                            @if (!string.IsNullOrEmpty(rutaFoto))
                            {
                                <img src="@rutaFoto"
                                     alt="@item.Nombre"
                                     class="img-fluid rounded-3"
                                     style="max-height: 205px; width: auto; object-fit: contain;"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />

                                <div class="text-center text-secondary opacity-75" style="display: none;">
                                    <i class="fas @(esCamiseta ? "fa-tshirt text-primary" : "fa-running text-success") fa-4x mb-2"></i>
                                    <span class="d-block small fw-semibold">Chacón Sport</span>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-secondary opacity-75">
                                    <i class="fas @(esCamiseta ? "fa-tshirt text-primary" : "fa-running text-success") fa-4x mb-2"></i>
                                    <span class="d-block small fw-semibold">Chacón Sport</span>
                                </div>
                            }
                        </div>

                        <!-- Información y Stock -->
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-dark mb-1 text-truncate" title="@item.Nombre">
                                @item.Nombre
                            </h6>
                            <p class="text-muted small mb-3" style="font-size: 0.85rem; height: 38px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                @descripcionLimpia
                            </p>

                            <!-- Tallas en Mostrador -->
                            <div class="mb-3 p-2 rounded-2" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="fw-bold text-secondary" style="font-size: 0.75rem;">TALLAS EN TIENDA:</small>
                                    <small class="fw-bold text-dark" style="font-size: 0.75rem;">Total: @stockTotal unids.</small>
                                </div>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var pt in ptDeEsteProducto)
                                    {
                                        var tallaNombre = tallasDisponibles?.FirstOrDefault(t => t.TallaID == pt.TallaID)?.Nombre ?? "";
                                        if (pt.StockActual > 0)
                                        {
                                            <span class="badge bg-white text-dark border px-2 py-1" style="font-size: 0.75rem;" title="Stock: @pt.StockActual unidades">
                                                <strong>@tallaNombre</strong>: <span class="text-success fw-bold">@pt.StockActual</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1 text-decoration-line-through opacity-50" style="font-size: 0.75rem;" title="Agotado">
                                                @tallaNombre
                                            </span>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Precio y Estado de Disponibilidad -->
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">PRECIO VENTA</small>
                                    <span class="fs-5 fw-bold text-dark">S/ @item.PrecioUnitario.ToString("N2")</span>
                                </div>
                                <div class="text-end">
                                    @if (stockTotal > 5)
                                    {
                                        <span class="badge px-2 py-1" style="background-color: rgba(0, 209, 102, 0.15); color: #009944; border: 1px solid #00d166;">
                                            <i class="fas fa-check-circle me-1"></i>Disponible
                                        </span>
                                    }
                                    else if (stockTotal > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                            <i class="fas fa-exclamation-triangle me-1"></i>Últimas unids.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="fas fa-times-circle me-1"></i>Agotado
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Pie con Acciones Rápidas -->
                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                            <div class="d-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.ProductoID" class="btn btn-sm btn-outline-secondary w-50 py-1" style="font-size: 0.8rem;">
                                    <i class="fas fa-info-circle me-1"></i>Detalles
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ProductoID" class="btn btn-sm btn-outline-primary w-50 py-1" style="font-size: 0.8rem;">
                                    <i class="fas fa-edit me-1"></i>Editar
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>