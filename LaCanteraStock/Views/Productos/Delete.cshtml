@model LaCanteraStock.Models.Producto

@{
    ViewData["Title"] = "Eliminar producto";
}

<h1>Eliminar producto</h1>
<h5>¿Seguro que quieres eliminar este producto?</h5>

<div asp-validation-summary="All" class="text-danger"></div>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Categoría</dt>
    <dd class="col-sm-9">@ViewBag.Categorias[Model.CategoriaID]</dd>

    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">S/ @Model.PrecioUnitario.ToString("N2")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.ProductoID" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
