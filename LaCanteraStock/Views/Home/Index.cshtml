@{
    ViewData["Title"] = "Inicio - Confecciones Chacón Sport";
}

<!-- SECCIÓN HERO / PRESENTACIÓN PRINCIPAL -->
<div class="p-4 p-md-5 mb-4 rounded-4 text-white shadow" style="background: linear-gradient(135deg, #08182b 0%, #10263f 60%, #162e4a 100%); border-bottom: 3px solid #00d166;">
    <div class="container-fluid py-2">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(0, 209, 102, 0.12); border: 1px solid rgba(0, 209, 102, 0.4);">
                    <span class="badge rounded-pill" style="background-color: #00d166; color: #08182b; font-weight: 700;">SEDE CAJAMARCA</span>
                    <small class="text-light fw-medium">Confección Textil &amp; Venta Directa</small>
                </div>

                <h1 class="display-5 fw-bold mb-3 tracking-tight">
                    Confecciones <span style="color: #00d166;">Chacón Sport</span>
                </h1>

                <p class="fs-5 text-light opacity-90 mb-4 lh-base">
                    Especialistas en indumentaria deportiva de alto rendimiento. Atendemos la demanda inmediata de mostrador con stock terminado y desarrollamos confecciones personalizadas al por mayor con tecnología de estampado DTF y sublimado textil para clubes, instituciones y empresas.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <!-- Redirección directa al Catálogo -->
                    <a asp-controller="Productos" asp-action="Catalogo" class="btn btn-lg px-4 py-2 fw-bold shadow-sm" style="background-color: #00d166; color: #08182b;">
                        <i class="fas fa-store me-2"></i>Ver Stock en Tienda
                    </a>
                    <a href="#contacto-sede" class="btn btn-lg btn-outline-light px-4 py-2 fw-semibold">
                        <i class="fas fa-map-marker-alt me-2 text-cantera-green"></i>Visítanos en Jr. Batán
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 d-flex gap-4 text-white-50 small">
                    <div>
                        <i class="fas fa-check-circle text-cantera-green me-1"></i> Taller y Atención: <strong>Cajamarca</strong>
                    </div>
                    <div>
                        <i class="fas fa-truck-moving text-cantera-green me-1"></i> Enlace textil directo: <strong>Lima</strong>
                    </div>
                </div>
            </div>

            <!-- FOTO DE LA TIENDA ADAPTADA COMPLETA (SIN MOCHARSE) -->
            <div class="col-lg-5 text-center">
                <div class="rounded-4 overflow-hidden shadow-lg border border-secondary border-opacity-25 d-flex flex-column align-items-center justify-content-center" style="background-color: #05111f; min-height: 400px; padding: 10px;">
                    <img src="/images/tienda/chacon_sport_local.jpeg"
                         alt="Local Confecciones Chacón Sport"
                         class="img-fluid rounded-3"
                         style="max-height: 420px; width: auto; object-fit: contain;"
                         onerror="this.src='/images/productos/camiseta_alianza_taller_chacon.jpg';" />

                    <div class="mt-2 text-white text-center small">
                        <span class="fw-bold d-block text-cantera-green">Confecciones Chacón Sport</span>
                        <span class="text-white-50">Jr. Batán N° 404 - Cajamarca</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SERVICIOS / MODUS OPERANDI CON ÍCONOS VISIBLES -->
<div class="container py-4">
    <div class="text-center mb-5">
        <h6 class="text-uppercase fw-bold" style="color: #00d166; letter-spacing: 1px;">Flujo de Trabajo y Servicios</h6>
        <h3 class="fw-bold text-dark">¿Cómo opera Confecciones Chacón?</h3>
        <p class="text-muted mx-auto" style="max-width: 700px;">
            Combinamos la disponibilidad inmediata en tienda física con la capacidad de fabricación a escala desde nuestro taller y alianzas textiles.
        </p>
    </div>

    <div class="row g-4">
        <!-- Stock Mostrador -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-3 bg-white">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 75px; height: 75px; background-color: #e9ecef;">
                    <i class="fas fa-tshirt fa-2x" style="color: #08182b;"></i>
                </div>
                <h5 class="fw-bold text-dark">Prendas de Stock Inmediato</h5>
                <p class="text-muted small">
                    Mostrador surtido con camisetas de equipos nacionales e internacionales, shorts y conjuntos deportivos listos en tallas para niños, jóvenes y adultos.
                </p>
                <div class="mt-auto">
                    <a asp-controller="Productos" asp-action="Catalogo" class="btn btn-sm btn-outline-dark fw-semibold">
                        <i class="fas fa-search me-1"></i>Consultar Prendas
                    </a>
                </div>
            </div>
        </div>

        <!-- Confección por Encargo -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-3 bg-white border-top border-3" style="border-top-color: #00d166 !important;">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 75px; height: 75px; background-color: rgba(0, 209, 102, 0.15);">
                    <i class="fas fa-cut fa-2x" style="color: #00b853;"></i>
                </div>
                <h5 class="fw-bold text-dark">Confección por Encargo</h5>
                <p class="text-muted small">
                    Producción a medida para campeonatos, colegios, empresas y delegaciones deportivas. Trabajamos con telas Win Umbro, Micro Pique y Dry de alto tránsito.
                </p>
                <div class="mt-auto">
                    <span class="badge bg-light text-dark border">Corte, Costura y Remalle</span>
                </div>
            </div>
        </div>

        <!-- Personalización DTF -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-3 bg-white">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 75px; height: 75px; background-color: #e9ecef;">
                    <i class="fas fa-print fa-2x" style="color: #08182b;"></i>
                </div>
                <h5 class="fw-bold text-dark">Estampado y Sublimado DTF</h5>
                <p class="text-muted small">
                    Colocación de números oficiales, nombres de jugadores, dorsales y logotipos de patrocinadores con tecnología termotransferible de alta adherencia y color vivo.
                </p>
                <div class="mt-auto">
                    <span class="badge bg-light text-dark border">Acabado Profesional</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MISIÓN Y VISIÓN -->
<div class="bg-white py-5 my-4 border-top border-bottom">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-6 pe-lg-4 border-end-lg">
                <div class="p-3">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle p-2 px-3 text-white" style="background-color: #08182b;">
                            <i class="fas fa-bullseye" style="color: #00d166;"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-0">Nuestra Misión</h4>
                    </div>
                    <p class="text-secondary leading-relaxed mb-0">
                        Proveer indumentaria deportiva duradera, estética y accesible para la comunidad cajamarquina, unificando la venta inmediata en tienda con un servicio ágil de confección y estampado personalizado, garantizando materiales de primera calidad y tiempos de entrega puntuales.
                    </p>
                </div>
            </div>

            <div class="col-lg-6 ps-lg-4">
                <div class="p-3">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle p-2 px-3 text-white" style="background-color: #08182b;">
                            <i class="fas fa-eye" style="color: #00d166;"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-0">Nuestra Visión</h4>
                    </div>
                    <p class="text-secondary leading-relaxed mb-0">
                        Consolidar a <strong>Chacón Sport</strong> como la marca y taller textil deportivo líder en la región Cajamarca, fortaleciendo el puente de abastecimiento y distribución con nuestra sede en Lima para ofrecer innovación constante en telas inteligentes y tecnología de estampado.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CONTACTO Y UBICACIÓN -->
<div class="container py-4 mb-3" id="contacto-sede">
    <div class="card border-0 rounded-4 overflow-hidden shadow" style="background-color: #08182b;">
        <div class="row g-0">
            <div class="col-lg-7 p-4 p-md-5 text-white d-flex flex-column justify-content-center">
                <span class="text-uppercase fw-bold small mb-2" style="color: #00d166;">Punto de Venta y Atención Principal</span>
                <h3 class="fw-bold mb-4">Sede Central Cajamarca</h3>

                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="fs-5 mt-1" style="color: #00d166;"><i class="fas fa-map-marked-alt"></i></div>
                    <div>
                        <strong class="text-white d-block">Dirección del Local:</strong>
                        <span class="text-light opacity-75">Jr. Batán N° 404, Cajamarca, Perú</span>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="fs-5 mt-1" style="color: #00d166;"><i class="fab fa-whatsapp"></i></div>
                    <div>
                        <strong class="text-white d-block">Teléfono / WhatsApp de Pedidos:</strong>
                        <a href="https://wa.me/51940114321" target="_blank" class="text-decoration-none fw-bold" style="color: #00d166;">
                            +51 940 114 321
                        </a>
                        <span class="text-light opacity-50 ms-2 small">(Consultas de stock y cotizaciones)</span>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3">
                    <div class="fs-5 mt-1" style="color: #00d166;"><i class="fas fa-building"></i></div>
                    <div>
                        <strong class="text-white d-block">Presencia y Enlace Textil:</strong>
                        <span class="text-light opacity-75">Sede y conexión directa con proveedores en Lima para pedidos a gran escala.</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 p-4 d-flex align-items-center justify-content-center" style="background-color: #10263f;">
                <div class="text-center text-white p-4 rounded-3 border border-secondary border-opacity-25 w-100">
                    <i class="fas fa-boxes fa-3x mb-3" style="color: #00d166;"></i>
                    <h5 class="fw-bold">Gestión de Stock en Tienda</h5>
                    <p class="text-light opacity-75 small mb-4">
                        Accede al inventario digital de camisetas y shorts listos para venta inmediata en el mostrador de Jr. Batán.
                    </p>
                    <a asp-controller="Productos" asp-action="Catalogo" class="btn w-100 fw-bold py-2" style="background-color: #00d166; color: #08182b;">
                        Ingresar al Catálogo
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>