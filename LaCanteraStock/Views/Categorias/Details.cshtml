@model LaCanteraStock.Models.Categoria

@{
    ViewData["Title"] = "Detalles de categoría";
}

<h1>Detalles de categoría</h1>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Descripción</dt>
    <dd class="col-sm-9">@Model.Descripcion</dd>

    <dt class="col-sm-3">Activo</dt>
    <dd class="col-sm-9">@(Model.Activo ? "Sí" : "No")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.CategoriaID">Editar</a> |
<a asp-action="Index">Volver a la lista</a>
