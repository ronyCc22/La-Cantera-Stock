@model IEnumerable<LaCanteraStock.Models.Pedido>

@{
    ViewData["Title"] = "Ventas";
}

<h1>Ventas</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva venta</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Boleta</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Estado</th>
            <th>Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NumeroBoleta</td>
                <td>@item.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@ViewBag.Clientes[item.ClienteID]</td>
                <td>@ViewBag.Estados[item.EstadoPedidoID]</td>
                <td>S/ @item.Total.ToString("N2")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.PedidoID">Ver</a>
                </td>
            </tr>
        }
    </tbody>
</table>
