<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaCanteraStock</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LaCanteraStock.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
    <nav class="navbar navbar-dark" style="background-color: #071A33;">
        <div class="container-fluid">

            <div class="w-100">

                <!-- Primera fila -->
                <div class="d-flex justify-content-between align-items-center py-2">

                    <div>
                        <a class="navbar-brand fw-bold" asp-controller="Categorias" asp-action="Index">
                            LA CANTERA <span style="color: #20B26B;">STOCK</span>
                        </a>

                        <small class="text-white-50 ms-2">
                            Tienda de ropa deportiva
                        </small>
                    </div>

                    <a class="nav-link text-white" href="#">
                        👤 Ingresar
                    </a>

                </div>

                <!-- Segunda fila -->
                <div class="border-top border-secondary pt-2 pb-2">
                    <ul class="navbar-nav flex-row gap-4">

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Productos" asp-action="Index">
                                Stock en tienda >
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" href="#">
                                Insumos >
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" href="#">
                                Ideas de diseños >
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Pedidos" asp-action="Index">
                                Pedidos >
                            </a>
                        </li>

                    </ul>
                </div>

            </div>

        </div>
    </nav>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - LaCanteraStock - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
