@model IEnumerable<LaCanteraStock.Models.DetalleConfeccion>

@{
    ViewData["Title"] = "Insumos - Confección";
}

<div class="container-fluid px-0">
    <!-- Cabecera -->
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">
                <i class="fa-solid fa-scissors me-2" style="color:#071A33;"></i>Insumos de Confección
            </h2>
            <p class="text-muted mb-0">Registra qué prenda se va a confeccionar, con qué tela, talla y tipo de estampado.</p>
        </div>
        <div>
            <a asp-action="Telas" class="btn btn-outline-dark me-2 shadow-sm fw-semibold">
                <i class="fa-solid fa-scroll me-1"></i> Gestionar Telas
            </a>
            <a asp-action="Create" class="btn text-white shadow-sm fw-semibold" style="background-color:#20B26B; border:none;">
                <i class="fa-solid fa-plus me-1"></i> Nuevo Detalle de Confección
            </a>
        </div>
    </div>

    <!-- Tarjetas de resumen -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 text-white" style="background-color:#071A33;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-white-50 small text-uppercase fw-bold">Registros de Confección</span>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalRegistros</h3>
                    </div>
                    <i class="fa-solid fa-clipboard-list fa-2x text-white-50"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-success bg-opacity-10 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small text-uppercase fw-bold text-success">Telas activas</span>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalTelas</h3>
                    </div>
                    <i class="fa-solid fa-scroll fa-2x opacity-50 text-success"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-primary bg-opacity-10 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="small text-uppercase fw-bold text-primary">Categorías</span>
                        <h3 class="fw-bold mb-0">@ViewBag.TotalCategorias</h3>
                    </div>
                    <i class="fa-solid fa-tags fa-2x opacity-50 text-primary"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color:#F8F9FA;">
                        <tr class="text-uppercase small text-muted">
                            <th class="ps-4 py-3">#</th>
                            <th class="py-3">Prenda a confeccionar</th>
                            <th class="py-3">Tela</th>
                            <th class="py-3">Talla</th>
                            <th class="py-3">Estampado</th>
                            <th class="py-3">Cantidad</th>
                            <th class="py-3">Fecha</th>
                            <th class="text-end pe-4 py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-folder-open fa-3x mb-3 d-block text-secondary"></i>
                                    <h5 class="fw-semibold">No hay registros de confección</h5>
                                    <p class="small mb-0">Haz clic en “Nuevo Detalle de Confección” para empezar.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold" style="color:#071A33;">#@item.DetalleConfeccionID</td>
                                    <td class="fw-semibold">@(item.Categoria?.Nombre ?? "—")</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-2">
                                            <i class="fa-solid fa-scroll me-1 text-muted"></i>@(item.Tela?.Nombre ?? "—")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-dark border">@(item.Talla?.Nombre ?? "—")</span>
                                    </td>
                                    <td>@(item.TipoEstampado?.Nombre ?? "—")</td>
                                    <td class="fw-bold">@item.Cantidad</td>
                                    <td class="text-muted small">
                                        <i class="fa-regular fa-calendar me-1"></i>@item.FechaRegistro.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Edit" asp-route-id="@item.DetalleConfeccionID" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.DetalleConfeccionID" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>