@model LaCanteraStock.Models.Tela

@{
    ViewData["Title"] = "Nueva Tela";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h4 class="mb-0 fw-bold" style="color:#071A33;">
                    <i class="fa-solid fa-scroll me-2" style="color:#20B26B;"></i>Nueva Tela
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateTela">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Tela</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej. Algodón peinado, Poliéster, Dry-Fit..." />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold">Descripción (opcional)</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="2" placeholder="Características de la tela..."></textarea>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="Activo" class="form-check-input" checked />
                        <label asp-for="Activo" class="form-check-label">Activo</label>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Telas" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn text-white px-4" style="background-color:#071A33; border:none;">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Tela
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}