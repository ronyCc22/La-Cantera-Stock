@model LaCanteraStock.Models.DetalleConfeccion

@{
    ViewData["Title"] = "Editar Detalle de Confección";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white border-bottom py-3">
                <h4 class="mb-0 fw-bold" style="color:#071A33;">
                    <i class="fa-solid fa-pen-to-square me-2" style="color:#20B26B;"></i>
                    Editar Detalle de Confección
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="DetalleConfeccionID" />
                    <input type="hidden" asp-for="FechaRegistro" />

                    <div class="mb-3">
                        <label asp-for="CategoriaID" class="form-label fw-semibold">Prenda a confeccionar</label>
                        <select asp-for="CategoriaID" class="form-select" asp-items="ViewBag.CategoriaID"></select>
                        <span asp-validation-for="CategoriaID" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TelaID" class="form-label fw-semibold">Tipo de Tela</label>
                        <select asp-for="TelaID" class="form-select" asp-items="ViewBag.TelaID"></select>
                        <span asp-validation-for="TelaID" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TallaID" class="form-label fw-semibold">Talla</label>
                            <select asp-for="TallaID" class="form-select" asp-items="ViewBag.TallaID"></select>
                            <span asp-validation-for="TallaID" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TipoEstampadoID" class="form-label fw-semibold">Tipo de Estampado</label>
                            <select asp-for="TipoEstampadoID" class="form-select" asp-items="ViewBag.TipoEstampadoID"></select>
                            <span asp-validation-for="TipoEstampadoID" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cantidad" class="form-label fw-semibold">Cantidad / Metros</label>
                        <input asp-for="Cantidad" class="form-control" min="1" />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Observacion" class="form-label fw-semibold">Observación</label>
                        <textarea asp-for="Observacion" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn text-white px-4 fw-semibold" style="background-color:#071A33; border:none;">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}