@model IEnumerable<LaCanteraStock.Models.Tela>

@{
    ViewData["Title"] = "Gestión de Telas";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">
            <i class="fa-solid fa-scroll me-2" style="color:#071A33;"></i>Telas (Insumos)
        </h2>
        <p class="text-muted mb-0">Administra los tipos de tela disponibles para confección.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary me-2 shadow-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a Insumos
        </a>
        <a asp-action="CreateTela" class="btn text-white shadow-sm fw-semibold" style="background-color:#20B26B; border:none;">
            <i class="fa-solid fa-plus me-1"></i> Nueva Tela
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color:#F8F9FA;">
                    <tr class="text-uppercase small text-muted">
                        <th class="ps-4 py-3">ID</th>
                        <th class="py-3">Nombre</th>
                        <th class="py-3">Descripción</th>
                        <th class="py-3">Estado</th>
                        <th class="text-end pe-4 py-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-scroll fa-3x mb-3 d-block text-secondary"></i>
                                <h5 class="fw-semibold">No hay telas registradas</h5>
                                <p class="small mb-0">Crea la primera tela para poder usarla en confección.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold" style="color:#071A33;">#@item.TelaID</td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td class="text-muted">@(string.IsNullOrEmpty(item.Descripcion) ? "—" : item.Descripcion)</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">
                                            <i class="fa-solid fa-circle-check me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">
                                            Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <span class="text-muted small">—</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>