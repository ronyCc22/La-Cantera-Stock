@model LaCanteraStock.Models.DetalleConfeccion

@{
    ViewData["Title"] = "Eliminar Detalle de Confección";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold">
                    <i class="fa-solid fa-trash me-2"></i>Confirmar Eliminación
                </h4>
            </div>
            <div class="card-body p-4">
                <p class="mb-4">¿Estás seguro de que deseas eliminar este registro de confección?</p>

                <dl class="row mb-4">
                    <dt class="col-sm-4">Prenda</dt>
                    <dd class="col-sm-8 fw-semibold">@(Model.Categoria?.Nombre ?? "—")</dd>

                    <dt class="col-sm-4">Tela</dt>
                    <dd class="col-sm-8">@(Model.Tela?.Nombre ?? "—")</dd>

                    <dt class="col-sm-4">Talla</dt>
                    <dd class="col-sm-8">@(Model.Talla?.Nombre ?? "—")</dd>

                    <dt class="col-sm-4">Estampado</dt>
                    <dd class="col-sm-8">@(Model.TipoEstampado?.Nombre ?? "—")</dd>

                    <dt class="col-sm-4">Cantidad</dt>
                    <dd class="col-sm-8">@Model.Cantidad</dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="DetalleConfeccionID" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash me-1"></i> Sí, Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>